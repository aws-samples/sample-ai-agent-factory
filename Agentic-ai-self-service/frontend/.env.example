# Backend API URL (leave empty when using CloudFront proxy)
VITE_API_BASE_URL=http://localhost:8000

# Cognito Authentication (required for deployed environments)
# Get these from CDK stack outputs or AWS Console
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# The region the platform is deployed to. scripts/deploy.sh injects this from
# AWS_REGION; set it locally so the Bedrock model picker offers the cross-region
# inference profiles that actually exist in your region (a `us.` profile does
# not exist in eu-central-1). Defaults to us-east-1 when empty.
VITE_AWS_REGION=us-east-1
