{
  "schema_version": 1,
  "suites": [
    {
      "id": "static",
      "working_directory": ".",
      "selector_type": "command",
      "check_ids": ["all-python-lint-format"],
      "commands": [
        ["{backend_python}", "-m", "ruff", "check", "."],
        ["{backend_python}", "-m", "ruff", "format", "--check", "."]
      ],
      "timeout_seconds": 900
    },
    {
      "id": "secret-scan",
      "working_directory": ".",
      "selector_type": "command",
      "check_ids": ["tracked-files-against-baseline"],
      "commands": [
        ["{backend_python}", "scripts/verify_secret_baseline.py"]
      ],
      "required_tools": {"detect-secrets-hook": "1.5.0"},
      "timeout_seconds": 900
    },
    {
      "id": "backend",
      "working_directory": "backend",
      "selector_type": "pytest",
      "commands": [
        ["{backend_python}", "-m", "pytest", "-m", "not integration and not policy_scan and not terraform_scan and not shell_scan", "-q", "--junit-xml={junit_xml}", "-o", "junit_family=xunit1"]
      ],
      "timeout_seconds": 7200
    },
    {
      "id": "export-gate",
      "working_directory": "backend",
      "selector_type": "pytest",
      "commands": [
        [
          "{backend_python}",
          "-m",
          "pytest",
          "tests/test_downloadable_asset_contract.py",
          "tests/test_python_exporter.py",
          "tests/test_cfn_export_contract.py",
          "tests/test_the_exported_template_can_actually_deploy.py",
          "tests/test_export_bundle_staging.py",
          "tests/test_export_bundle_isolation.py",
          "tests/test_litellm_secret_region_is_enforced_in_the_template.py",
          "tests/test_release_documentation_contract.py",
          "tests/test_ci_workflow_gates.py",
          "-q",
          "--junit-xml={junit_xml}",
          "-o",
          "junit_family=xunit1"
        ],
        ["{actionlint}", "../../.github/workflows/agentic-ai-self-service-ci.yml"]
      ],
      "required_tools": {
        "cfn-lint": "1.57.0",
        "checkov": "3.3.1",
        "terraform": "1.14.6",
        "shellcheck": "0.11.0",
        "actionlint": "1.7.12"
      },
      "required_environment": ["CI"],
      "timeout_seconds": 7200
    },
    {
      "id": "infra",
      "working_directory": "infra",
      "selector_type": "pytest",
      "check_ids": ["all-infrastructure-tests"],
      "commands": [
        ["{infra_python}", "-m", "pytest", "tests/", "-q", "--junit-xml={junit_xml}", "-o", "junit_family=xunit1"]
      ],
      "timeout_seconds": 3600
    },
    {
      "id": "frontend",
      "working_directory": "frontend",
      "selector_type": "javascript",
      "check_ids": ["lint-test-build-verify"],
      "commands": [
        ["{npm}", "audit", "--audit-level=high"],
        ["{npm}", "run", "lint"],
        ["{npm}", "run", "test", "--", "--reporter=default", "--reporter=junit", "--outputFile={junit_xml}"],
        ["{npm}", "run", "build"],
        ["{npm}", "run", "verify:production-build"]
      ],
      "required_environment": [
        "VITE_API_BASE_URL",
        "VITE_AWS_REGION",
        "VITE_COGNITO_USER_POOL_ID",
        "VITE_COGNITO_CLIENT_ID"
      ],
      "timeout_seconds": 3600
    },
    {
      "id": "backend-package",
      "working_directory": "backend",
      "selector_type": "command",
      "check_ids": ["wheel-and-sdist"],
      "commands": [
        ["{uv}", "build", "--out-dir", "{artifact_dir}/backend-dist"]
      ],
      "timeout_seconds": 900
    },
    {
      "id": "strict-synth",
      "working_directory": "infra",
      "selector_type": "command",
      "check_ids": ["production-certified-regions-cdk-nag"],
      "commands": [
        ["{cdk}", "synth", "--strict", "--quiet", "--output", "{artifact_dir}/cdk-us-east-1", "-c", "environment_name=production", "-c", "aws_region=us-east-1", "-c", "project_name=acf"],
        ["{cdk}", "synth", "--strict", "--quiet", "--output", "{artifact_dir}/cdk-us-east-2", "-c", "environment_name=production", "-c", "aws_region=us-east-2", "-c", "project_name=acf"],
        ["{cdk}", "synth", "--strict", "--quiet", "--output", "{artifact_dir}/cdk-us-west-2", "-c", "environment_name=production", "-c", "aws_region=us-west-2", "-c", "project_name=acf"],
        ["{cdk}", "synth", "--strict", "--quiet", "--output", "{artifact_dir}/cdk-eu-central-1", "-c", "environment_name=production", "-c", "aws_region=eu-central-1", "-c", "project_name=acf"],
        ["{cdk}", "synth", "--strict", "--quiet", "--output", "{artifact_dir}/cdk-eu-west-1", "-c", "environment_name=production", "-c", "aws_region=eu-west-1", "-c", "project_name=acf"],
        ["{cdk}", "synth", "--strict", "--quiet", "--output", "{artifact_dir}/cdk-eu-west-2", "-c", "environment_name=production", "-c", "aws_region=eu-west-2", "-c", "project_name=acf"],
        ["{cdk}", "synth", "--strict", "--quiet", "--output", "{artifact_dir}/cdk-eu-west-3", "-c", "environment_name=production", "-c", "aws_region=eu-west-3", "-c", "project_name=acf"]
      ],
      "required_environment": ["CDK_PYTHON", "CDK_HOME", "TMPDIR"],
      "timeout_seconds": 3600
    }
  ],
