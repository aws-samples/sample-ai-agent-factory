{
  "tools": [
    {
      "name": "execute_query",
      "description": "Execute a SQL query against the database",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "SQL query to execute" },
          "maxRows": { "type": "number", "description": "Maximum rows to return" }
        },
        "required": ["query"]
      }
    },
    {
      "name": "drop_table",
      "description": "Drop a database table (DESTRUCTIVE)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tableName": { "type": "string", "description": "Table name to drop" }
        },
        "required": ["tableName"]
      }
    },
    {
      "name": "truncate_table",
      "description": "Truncate all data from a table (DESTRUCTIVE)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tableName": { "type": "string", "description": "Table name to truncate" }
        },
        "required": ["tableName"]
      }
    },
    {
      "name": "delete_records",
      "description": "Delete records matching a condition (DESTRUCTIVE)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": { "type": "string", "description": "Table name" },
          "where": { "type": "string", "description": "WHERE clause" }
        },
        "required": ["table", "where"]
      }
    },
    {
      "name": "bulk_export",
      "description": "Export all data from a table",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": { "type": "string", "description": "Table to export" },
          "format": { "type": "string", "description": "Export format (json, csv)" }
        },
        "required": ["table"]
      }
    },
    {
      "name": "query_audit_logs",
      "description": "Query system audit logs (sensitive)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "startDate": { "type": "string", "description": "Start date (ISO 8601)" },
          "endDate": { "type": "string", "description": "End date (ISO 8601)" }
        },
        "required": ["startDate"]
      }
    },
    {
      "name": "export_pii_report",
      "description": "Export PII data report (highly sensitive)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "department": { "type": "string", "description": "Department to export" }
        },
        "required": ["department"]
      }
    }
  ]
}
