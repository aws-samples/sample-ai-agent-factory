# Machine-generated deploy output — contains resource ids and DEMO Cognito
# passwords. Do not commit.
DEPLOY_STATE.json

# Deployer-resolved client configs (contain the live gateway URL).
kiro-config/*.resolved.json

# Live MCP configs minted with a real JWT in the Authorization header.
.kiro/settings/mcp.json
.kiro/agents/governance-test.json
.mcp.json

# Local Claude Code tooling: settings + the local session/audit log.
.claude/settings.local.json
.claude/SESSION-LOG.md

# Security-scanner output / local state.
.ash/

# Python / test artifacts
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/

# CDK build artifacts (cloud assemblies / staging)
cdk.out/
cdk/cdk.out/
.cdk.staging/
cdk/.cdk.staging/

# OS cruft
.DS_Store

# Consent SPA runtime config: generated by scripts/deploy-connector-auth.sh from stack
# outputs and holds live account-specific ids. Track config.example.json instead.
connectors/authorize-spa/config.json
