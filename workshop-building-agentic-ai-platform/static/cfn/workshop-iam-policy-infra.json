{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsoleHomePage",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListDashboards",
        "cost-optimization-hub:ListEnrollmentStatuses",
        "health:DescribeEventAggregates",
        "iam:GetAccountSummary",
        "iam:ListAccessKeys",
        "iam:ListMFADevices",
        "securityhub:DescribeHub",
        "servicecatalog:ListApplications",
        "tag:GetResources",
        "tag:GetTagKeys",
        "trustedadvisor:DescribeAccount",
        "trustedadvisor:DescribeChecks",
        "trustedadvisor:DescribeCheckSummaries"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoRead",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:ListUserPools",
        "cognito-idp:ListUserPoolClients",
        "cognito-idp:ListUsers",
        "cognito-idp:ListGroups",
        "cognito-idp:GetGroup",
        "cognito-idp:ListResourceServers",
        "cognito-idp:DescribeResourceServer"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoWrite",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminGetUser",
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminDeleteUser",
        "cognito-idp:AdminAddUserToGroup",
        "cognito-idp:AdminRemoveUserFromGroup",
        "cognito-idp:CreateGroup",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:AdminSetUserPassword",
        "cognito-idp:AdminInitiateAuth"
      ],
      "Resource": "arn:aws:cognito-idp:*:*:userpool/*"
    },
    {
      "Sid": "DynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:TagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/workshop-*"
      ]
    },
    {
      "Sid": "DynamoDBList",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListTables"
      ],
      "Resource": "*"
    },
    {
      "Sid": "APIGatewayAccess",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:DELETE",
        "apigateway:PATCH",
        "execute-api:Invoke"
      ],
      "Resource": [
        "arn:aws:apigateway:*::/restapis*",
        "arn:aws:apigateway:*::/apis*",
        "arn:aws:execute-api:*:*:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "XRayAccess",
      "Effect": "Allow",
      "Action": [
        "xray:GetTraceSummaries",
        "xray:BatchGetTraces",
        "xray:GetServiceGraph",
        "xray:GetTraceGraph",
        "xray:GetInsight",
        "xray:GetGroups",
        "xray:GetGroup"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ECRAuthToken",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ECRAccess",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:DescribeRepositories",
        "ecr:ListImages",
        "ecr:DescribeImages",
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:PutLifecyclePolicy",
        "ecr:SetRepositoryPolicy",
        "ecr:GetRepositoryPolicy",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:TagResource"
      ],
      "Resource": [
        "arn:aws:ecr:*:*:repository/workshop-*",
        "arn:aws:ecr:*:*:repository/cdk-hnb659fds-*"
      ]
    },
    {
      "Sid": "ECSResourceScoped",
      "Effect": "Allow",
      "Action": [
        "ecs:DeleteCluster",
        "ecs:CreateService",
        "ecs:DeleteService",
        "ecs:UpdateService",
        "ecs:DescribeServices",
        "ecs:DescribeTasks",
        "ecs:RunTask",
        "ecs:StopTask",
        "ecs:TagResource",
        "ecs:PutClusterCapacityProviders"
      ],
      "Resource": [
        "arn:aws:ecs:*:*:cluster/workshop-*",
        "arn:aws:ecs:*:*:service/workshop-*/*",
        "arn:aws:ecs:*:*:task/workshop-*/*",
        "arn:aws:ecs:*:*:task-definition/workshop-*:*"
      ]
    },
    {
      "Sid": "ECSAccountLevel",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:ListClusters",
        "ecs:ListServices",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions",
        "ecs:ListTasks"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ECSTaskDefinitionWorkshopFamiliesOnly",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "arn:aws:ecs:*:*:task-definition/workshop-*:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "CloudFrontRead",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:ListDistributions",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:ListOriginAccessControls",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFrontDeleteAndUpdateTaggedOnly",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DeleteDistribution",
        "cloudfront:UpdateDistribution"
      ],
      "Resource": "arn:aws:cloudfront::*:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Workshop": "AgentCore-Platform"
        }
      }
    },
    {
      "Sid": "CloudFrontTagAndInvalidate",
      "Effect": "Allow",
      "Action": [
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:ListTagsForResource",
        "cloudfront:CreateInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::*:distribution/*"
    },
    {
      "Sid": "CloudFrontManageOac",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DeleteOriginAccessControl"
      ],
      "Resource": "arn:aws:cloudfront::*:origin-access-control/*"
    },
    {
      "Sid": "ECSCreateWorkshopClusterOnly",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster"
      ],
      "Resource": "arn:aws:ecs:*:*:cluster/workshop-*"
    }
  ]
}
