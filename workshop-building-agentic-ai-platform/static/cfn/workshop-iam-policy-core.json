{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvokeModelsScoped",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:GetFoundationModel",
        "bedrock:GetInferenceProfile"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:*:inference-profile/*",
        "arn:aws:bedrock:*:*:application-inference-profile/*"
      ]
    },
    {
      "Sid": "BedrockCatalogNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModelAvailability",
        "bedrock:ListInferenceProfiles",
        "bedrock:PutUseCaseForModelAccess",
        "bedrock:GetUseCaseForModelAccess",
        "bedrock:ListGuardrails",
        "bedrock:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "BedrockGuardrailWrite",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateGuardrail",
        "bedrock:ApplyGuardrail",
        "bedrock:UpdateGuardrail",
        "bedrock:DeleteGuardrail",
        "bedrock:GetGuardrail",
        "bedrock:CreateGuardrailVersion",
        "bedrock:TagResource",
        "bedrock:UntagResource"
      ],
      "Resource": "arn:aws:bedrock:*:*:guardrail/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ACRegistryServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/agent-registry.amazonaws.com/AWSServiceRoleForAgentRegistry",
      "Condition": {
        "StringLike": {
          "iam:AWSServiceName": "agent-registry.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ACGatewayCreate",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateGateway"
      ],
      "Resource": "arn:aws:bedrock-agentcore:*:*:gateway/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ACGatewaySyncAuthorizedOnWildcardArnByCreateGateway",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:SynchronizeGatewayTargets"
      ],
      "Resource": "arn:aws:bedrock-agentcore:*:*:gateway/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ACGatewayRead",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetGateway",
        "bedrock-agentcore:ListGateways",
        "bedrock-agentcore:GetGatewayTarget",
        "bedrock-agentcore:ListGatewayTargets",
        "bedrock-agentcore:GetAgentRuntime",
        "bedrock-agentcore:ListAgentRuntimes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ACPolicyEngineCreate",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreatePolicyEngine"
      ],
      "Resource": "arn:aws:bedrock-agentcore:*:*:policy-engine/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ACPolicyRead",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetPolicyEngine",
        "bedrock-agentcore:ListPolicyEngines",
        "bedrock-agentcore:GetPolicy",
        "bedrock-agentcore:ListPolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ACEvents",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListEvents",
        "bedrock-agentcore:ListActors"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ACMemoryRead",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListSessions"
      ],
      "Resource": "arn:aws:bedrock-agentcore:*:*:memory/*"
    },
    {
      "Sid": "S3Access",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetObjectAcl",
        "s3:GetBucketAcl"
      ],
      "Resource": [
        "arn:aws:s3:::workshop-*",
        "arn:aws:s3:::fast-*",
        "arn:aws:s3:::cdk-hnb659fds-assets-${aws:PrincipalAccount}-*"
      ]
    },
    {
      "Sid": "S3ObjectAclForFastAmplifyStaging",
      "Effect": "Allow",
      "Action": [
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::fast-*/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${aws:PrincipalAccount}"
        },
        "StringNotEqualsIfExists": {
          "s3:x-amz-acl": [
            "public-read",
            "public-read-write",
            "authenticated-read"
          ]
        }
      }
    },
    {
      "Sid": "S3List",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "STSAssumePersonaRolesAndBoundaryCappedCdkRoles",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/workshop-ac-registry-admin-*",
        "arn:aws:iam::*:role/workshop-ac-registry-publisher-*",
        "arn:aws:iam::*:role/workshop-ac-registry-consumer-*",
        "arn:aws:iam::*:role/cdk-hnb659fds-deploy-role-*-us-west-2",
        "arn:aws:iam::*:role/cdk-hnb659fds-deploy-role-*-us-east-1",
        "arn:aws:iam::*:role/cdk-hnb659fds-deploy-role-*-eu-west-1",
        "arn:aws:iam::*:role/cdk-hnb659fds-*-publishing-role-*-us-west-2",
        "arn:aws:iam::*:role/cdk-hnb659fds-*-publishing-role-*-us-east-1",
        "arn:aws:iam::*:role/cdk-hnb659fds-*-publishing-role-*-eu-west-1"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    },
    {
      "Sid": "STSReadOnly",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
