{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentDbForDataStackNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "rds:DescribeDBSubnetGroups",
        "rds:DescribeDBClusterParameterGroups",
        "rds:DescribeDBClusterParameters"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "DocumentDbForDataStack",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBCluster",
        "rds:DeleteDBCluster",
        "rds:ModifyDBCluster",
        "rds:CreateDBInstance",
        "rds:DeleteDBInstance",
        "rds:ModifyDBInstance",
        "rds:CreateDBSubnetGroup",
        "rds:DeleteDBSubnetGroup",
        "rds:CreateDBClusterParameterGroup",
        "rds:DeleteDBClusterParameterGroup",
        "rds:ModifyDBClusterParameterGroup",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource",
        "rds:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rds:*:*:cluster:workshop-*",
        "arn:aws:rds:*:*:db:workshop-*",
        "arn:aws:rds:*:*:subgrp:workshop-*",
        "arn:aws:rds:*:*:cluster-pg:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "KmsCreateAndListNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:ListAliases",
        "kms:ListKeys"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "KmsWorkshopAlias",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:kms:*:*:alias/workshop-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "KmsAliasTargetKeyMustBeWorkshopTagged",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:kms:*:*:key/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ],
          "aws:ResourceTag/Workshop": "AgentCore-Platform"
        }
      }
    },
    {
      "Sid": "KmsManageTaggedWorkshopKeys",
      "Effect": "Allow",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DescribeKey",
        "kms:EnableKeyRotation",
        "kms:DisableKeyRotation",
        "kms:GetKeyRotationStatus",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:CreateGrant",
        "kms:RevokeGrant",
        "kms:RetireGrant",
        "kms:ListGrants",
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ListResourceTags"
      ],
      "Resource": "arn:aws:kms:*:*:key/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ],
          "aws:ResourceTag/Workshop": "AgentCore-Platform"
        }
      }
    },
    {
      "Sid": "SecretsManagerForWorkshopSecretsNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetRandomPassword"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "SecretsManagerForWorkshopSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:*:secret:workshop*",
        "arn:aws:secretsmanager:*:*:secret:ac-admin-password*",
        "arn:aws:secretsmanager:*:*:secret:CodeEditor-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "SsmParametersForWorkshopNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "SsmParametersForWorkshop",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParametersByPath",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/workshop*",
        "arn:aws:ssm:*:*:parameter/FAST-stack/*",
        "arn:aws:ssm:*:*:parameter/agentcore-gateway/*",
        "arn:aws:ssm:*:*:parameter/keycloak/*",
        "arn:aws:ssm:*:*:parameter/cdk-bootstrap/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "SsmDocumentsForCodeEditorBootstrapNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeDocument",
        "ssm:ListAssociations",
        "ssm:DescribeAssociation"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "SsmDocumentsForCodeEditorBootstrap",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:UpdateDocument",
        "ssm:DeleteDocument",
        "ssm:GetDocument",
        "ssm:ListTagsForResource",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:document/code-editor-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "EventBridgeForSyncRuleNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "events:ListRules"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "EventBridgeForSyncRule",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:DeleteRule",
        "events:DescribeRule",
        "events:EnableRule",
        "events:DisableRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:ListTargetsByRule",
        "events:ListTagsForResource",
        "events:TagResource",
        "events:UntagResource"
      ],
      "Resource": [
        "arn:aws:events:*:*:rule/workshop-*",
        "arn:aws:events:*:*:rule/ac-*",
        "arn:aws:events:*:*:rule/agentcore-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "SnsForObservabilityNotificationsNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "sns:ListTopics",
        "sns:ListSubscriptions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "SnsForObservabilityNotifications",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:sns:*:*:workshop-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    }
  ]
}
