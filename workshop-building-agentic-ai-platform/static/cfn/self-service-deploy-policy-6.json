{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcsManageWorkshopClustersAndServices",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DeleteCluster",
        "ecs:DescribeClusters",
        "ecs:CreateService",
        "ecs:DeleteService",
        "ecs:UpdateService",
        "ecs:DescribeServices",
        "ecs:DescribeTasks",
        "ecs:RunTask",
        "ecs:StopTask",
        "ecs:TagResource",
        "ecs:UntagResource",
        "ecs:PutClusterCapacityProviders",
        "ecs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ecs:*:*:cluster/workshop-*",
        "arn:aws:ecs:*:*:service/workshop-*",
        "arn:aws:ecs:*:*:task-definition/workshop-*:*",
        "arn:aws:ecs:*:*:task/workshop-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "EcsAccountReadNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "ecs:ListClusters",
        "ecs:ListServices",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions",
        "ecs:ListTasks",
        "ecs:DescribeServiceDeployments",
        "ecs:ListServiceDeployments"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "EcsRegisterTaskDefinitionWorkshopFamiliesOnly",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "arn:aws:ecs:*:*:task-definition/workshop-*:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "EcsDeregisterTaskDefinitionNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "ecs:DeregisterTaskDefinition"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "AasEcsScalingWrites",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:RegisterScalableTarget",
        "application-autoscaling:DeregisterScalableTarget",
        "application-autoscaling:PutScalingPolicy",
        "application-autoscaling:DeleteScalingPolicy"
      ],
      "Resource": "arn:aws:application-autoscaling:*:*:scalable-target/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ],
          "application-autoscaling:service-namespace": "ecs"
        }
      }
    },
    {
      "Sid": "AasScalableTargetTagging",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:TagResource",
        "application-autoscaling:UntagResource"
      ],
      "Resource": "arn:aws:application-autoscaling:*:*:scalable-target/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "AasReadNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:DescribeScalableTargets",
        "application-autoscaling:DescribeScalingPolicies",
        "application-autoscaling:DescribeScalingActivities",
        "application-autoscaling:DescribeScheduledActions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "EcrForCdkContainerAssets",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:DescribeRepositories",
        "ecr:ListImages",
        "ecr:DescribeImages",
        "ecr:CreateRepository",
        "ecr:BatchDeleteImage",
        "ecr:DeleteRepository",
        "ecr:PutLifecyclePolicy",
        "ecr:SetRepositoryPolicy",
        "ecr:GetRepositoryPolicy",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:TagResource",
        "ecr:UntagResource"
      ],
      "Resource": "arn:aws:ecr:*:*:repository/cdk-hnb659fds-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "EcrAuthTokenNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "LogsAccountReadNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeIndexPolicies",
        "logs:DescribeResourcePolicies"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "LogsForWorkshopLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:CreateLogStream",
        "logs:DeleteLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws/lambda/workshop-*:*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/ac-*:*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/agentcore-*:*",
        "arn:aws:logs:*:*:log-group:/ecs/workshop*:*",
        "arn:aws:logs:*:*:log-group:/aws/ecs/workshop*:*",
        "arn:aws:logs:*:*:log-group:/aws/ssm/*:*",
        "arn:aws:logs:*:*:log-group:/aws/vendedlogs/*:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "CloudWatchAccountLevelNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:ListDashboards"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "CloudWatchWorkshopAlarmsAndDashboards",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:PutDashboard",
        "cloudwatch:DeleteDashboards",
        "cloudwatch:GetDashboard",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:cloudwatch:*:*:alarm:workshop-*",
        "arn:aws:cloudwatch::*:dashboard/workshop-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    }
  ]
}
