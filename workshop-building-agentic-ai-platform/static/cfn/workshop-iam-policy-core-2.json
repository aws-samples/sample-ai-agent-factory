{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::*:role/workshop-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "bedrock.amazonaws.com",
            "bedrock-agentcore.amazonaws.com",
            "agent-registry.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "IAMRoleRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::*:role/workshop-*",
        "arn:aws:iam::*:role/cdk-hnb659fds-*"
      ]
    },
    {
      "Sid": "IAMCdkRolesBounded",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/cdk-hnb659fds-*",
      "Condition": {
        "ArnLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/workshop-permissions-boundary"
        }
      }
    },
    {
      "Sid": "IAMCdkExecRoleAdminUnderBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/cdk-hnb659fds-cfn-exec-role-*",
      "Condition": {
        "ArnLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/workshop-permissions-boundary"
        },
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AdministratorAccess"
        }
      }
    },
    {
      "Sid": "IAMCdkLookupRoleReadOnlyUnderBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/cdk-hnb659fds-lookup-role-*",
      "Condition": {
        "ArnLike": {
          "iam:PermissionsBoundary": "arn:aws:iam::*:policy/workshop-permissions-boundary"
        },
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/ReadOnlyAccess"
        }
      }
    },
    {
      "Sid": "IAMPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": [
        "arn:aws:iam::*:policy/workshop-*",
        "arn:aws:iam::*:policy/cdk-hnb659fds-*"
      ]
    },
    {
      "Sid": "DenyTouchingTheWorkshopBoundaryPolicy",
      "Effect": "Deny",
      "Action": [
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::*:policy/workshop-permissions-boundary"
    },
    {
      "Sid": "IAMListReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:ListPolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CFNCdkToolkitBootstrap",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:ListChangeSets",
        "cloudformation:SignalResource",
        "cloudformation:TagResource"
      ],
      "Resource": [
        "arn:aws:cloudformation:*:*:stack/CDKToolkit/*"
      ]
    },
    {
      "Sid": "CFNReadFastStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ListChangeSets"
      ],
      "Resource": [
        "arn:aws:cloudformation:*:*:stack/FAST-stack/*",
        "arn:aws:cloudformation:*:*:stack/FAST-stack-*/*"
      ]
    },
    {
      "Sid": "CFNReadWorkshopStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ListChangeSets"
      ],
      "Resource": "arn:aws:cloudformation:*:*:stack/workshop-*/*"
    },
    {
      "Sid": "CFNReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ListStacks",
        "cloudformation:ListExports",
        "cloudformation:ListImports",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:TagLogGroup",
        "logs:AssociateKmsKey",
        "logs:PutSubscriptionFilter",
        "logs:DeleteSubscriptionFilter"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws/lambda/workshop-*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/ac-*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/agentcore-*",
        "arn:aws:logs:*:*:log-group:/ecs/workshop*",
        "arn:aws:logs:*:*:log-group:/aws/ecs/workshop*",
        "arn:aws:logs:*:*:log-group:/workshop/*"
      ]
    },
    {
      "Sid": "ACGatewayManage",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:UpdateGateway",
        "bedrock-agentcore:DeleteGateway",
        "bedrock-agentcore:CreateGatewayTarget",
        "bedrock-agentcore:DeleteGatewayTarget",
        "bedrock-agentcore:SynchronizeGatewayTargets",
        "bedrock-agentcore:PutResourcePolicy",
        "bedrock-agentcore:ManageResourceScopedPolicy"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:*:*:gateway/tools-gateway-*",
        "arn:aws:bedrock-agentcore:*:*:gateway/ac-tools-gateway-*"
      ]
    },
    {
      "Sid": "ACIdentityManage",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:UpdateWorkloadIdentity",
        "bedrock-agentcore:DeleteWorkloadIdentity"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:*:*:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:*:*:workload-identity-directory/default/workload-identity/registry-*"
      ]
    },
    {
      "Sid": "ACTokenVaultManage",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateOauth2CredentialProvider",
        "bedrock-agentcore:DeleteOauth2CredentialProvider"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:*:*:token-vault/default/oauth2credentialprovider/workshop-*",
        "arn:aws:bedrock-agentcore:*:*:token-vault/default"
      ]
    }
  ]
}
