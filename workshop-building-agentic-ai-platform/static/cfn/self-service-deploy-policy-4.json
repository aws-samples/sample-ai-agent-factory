{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IamRolesAndPoliciesScopedToWorkshopPrefix",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::*:role/workshop-*",
        "arn:aws:iam::*:policy/workshop-*",
        "arn:aws:iam::*:role/code-editor-*",
        "arn:aws:iam::*:policy/code-editor-*"
      ]
    },
    {
      "Sid": "IamCreateServiceLinkedRoleOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/aws-service-role/ecs.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/ops.apigateway.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/elasticloadbalancing.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/elasticfilesystem.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/ec2-nat-gateway.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/rds.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/agent-registry.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/bedrock-agentcore.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/network.bedrock-agentcore.amazonaws.com/*",
        "arn:aws:iam::*:role/aws-service-role/runtime-identity.bedrock-agentcore.amazonaws.com/*"
      ]
    },
    {
      "Sid": "IamInstanceProfileForCodeEditorIde",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:instance-profile/code-editor-*",
        "arn:aws:iam::*:instance-profile/workshop-*"
      ]
    },
    {
      "Sid": "AccountLevelReadOnlyNoArnSupport",
      "Effect": "Allow",
      "Action": [
        "iam:ListPolicies",
        "iam:ListRoles",
        "iam:GetInstanceProfile",
        "iam:ListInstanceProfilesForRole",
        "iam:GetAccountSummary",
        "iam:ListEntitiesForPolicy",
        "iam:GetServiceLinkedRoleDeletionStatus",
        "cloudfront:ListDistributions",
        "cloudfront:ListOriginAccessControls",
        "cloudfront:GetConnectionGroup",
        "cloudfront:GetVpcOrigin",
        "route53:ListHostedZonesByName",
        "route53:ListHostedZonesByVPC",
        "sts:GetCallerIdentity",
        "s3:ListAllMyBuckets",
        "aws-marketplace:ViewSubscriptions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamPassRoleToWorkshopServicesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/workshop-*",
        "arn:aws:iam::*:role/code-editor-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "bedrock.amazonaws.com",
            "bedrock-agentcore.amazonaws.com",
            "agent-registry.amazonaws.com",
            "cloudformation.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "ec2.amazonaws.com",
            "apigateway.amazonaws.com",
            "events.amazonaws.com",
            "aps.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CloudFrontCreateScoped",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:CreateCachePolicy"
      ],
      "Resource": [
        "arn:aws:cloudfront::*:distribution/*",
        "arn:aws:cloudfront::*:origin-access-control/*",
        "arn:aws:cloudfront::*:cache-policy/*"
      ]
    },
    {
      "Sid": "Route53CreateHostedZoneNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "route53:CreateHostedZone"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFrontDeleteAndUpdateTaggedOnly",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DeleteDistribution",
        "cloudfront:UpdateDistribution"
      ],
      "Resource": "arn:aws:cloudfront::*:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Workshop": "AgentCore-Platform"
        }
      }
    },
    {
      "Sid": "CloudFrontReadTagAndInvalidateDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:ListTagsForResource",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "arn:aws:cloudfront::*:distribution/*"
    },
    {
      "Sid": "CloudFrontManageOacAndCachePolicy",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DeleteOriginAccessControl",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:UpdateCachePolicy",
        "cloudfront:DeleteCachePolicy",
        "cloudfront:GetCachePolicy",
        "cloudfront:GetCachePolicyConfig"
      ],
      "Resource": [
        "arn:aws:cloudfront::*:origin-access-control/*",
        "arn:aws:cloudfront::*:cache-policy/*"
      ]
    },
    {
      "Sid": "Route53ManageCloudMapPrivateDnsHostedZone",
      "Effect": "Allow",
      "Action": [
        "route53:AssociateVPCWithHostedZone",
        "route53:DisassociateVPCFromHostedZone",
        "route53:DeleteHostedZone",
        "route53:GetHostedZone",
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets",
        "route53:GetChange"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/*",
        "arn:aws:route53:::change/*"
      ]
    },
    {
      "Sid": "StsAssumeWorkshopPersonaRoles",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/workshop-*"
      ]
    },
    {
      "Sid": "MarketplaceSubscribeForBedrockModelAccess",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:Subscribe"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3DeployAssetsBucketScoped",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::cfn-deploy-*",
        "arn:aws:s3:::workshop-*"
      ]
    }
  ]
}
