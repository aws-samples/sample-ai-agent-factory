{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ACRegistryListNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "agent-registry:ListRegistries"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ACRegistryCreate",
      "Effect": "Allow",
      "Action": [
        "agent-registry:CreateRegistry"
      ],
      "Resource": "arn:aws:agent-registry:*:*:registry/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ACRegistryManage",
      "Effect": "Allow",
      "Action": [
        "agent-registry:GetRegistry",
        "agent-registry:UpdateRegistry",
        "agent-registry:DeleteRegistry",
        "agent-registry:CreateRegistryRecord",
        "agent-registry:GetRegistryRecord",
        "agent-registry:ListRegistryRecords",
        "agent-registry:UpdateRegistryRecord",
        "agent-registry:DeleteRegistryRecord",
        "agent-registry:SubmitRegistryRecordForApproval",
        "agent-registry:UpdateRegistryRecordStatus",
        "agent-registry:TagResource",
        "agent-registry:UntagResource",
        "agent-registry:ListTagsForResource"
      ],
      "Resource": "arn:aws:agent-registry:*:*:registry/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "CdkBootstrapStagingBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketAcl",
        "s3:PutEncryptionConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:PutBucketVersioning",
        "s3:GetBucketVersioning",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutLifecycleConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:PutBucketTagging",
        "s3:GetBucketTagging"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-${aws:PrincipalAccount}-*"
    },
    {
      "Sid": "CdkBootstrapEcrRepositoryConfiguration",
      "Effect": "Allow",
      "Action": [
        "ecr:PutImageTagMutability",
        "ecr:GetLifecyclePolicy",
        "ecr:DeleteLifecyclePolicy",
        "ecr:ListTagsForResource",
        "ecr:UntagResource"
      ],
      "Resource": "arn:aws:ecr:*:*:repository/cdk-hnb659fds-*"
    },
    {
      "Sid": "CdkBootstrapVersionParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/cdk-bootstrap/*"
    },
    {
      "Sid": "AmplifyCreateAppScoped",
      "Effect": "Allow",
      "Action": [
        "amplify:CreateApp"
      ],
      "Resource": "arn:aws:amplify:*:*:apps/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "AmplifyListNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "amplify:ListApps"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "AmplifyRead",
      "Effect": "Allow",
      "Action": [
        "amplify:GetApp",
        "amplify:GetBranch",
        "amplify:ListBranches",
        "amplify:GetJob",
        "amplify:ListJobs"
      ],
      "Resource": "arn:aws:amplify:*:*:apps/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "AmplifyWriteScopedToApps",
      "Effect": "Allow",
      "Action": [
        "amplify:DeleteApp",
        "amplify:UpdateApp",
        "amplify:CreateBranch",
        "amplify:DeleteBranch",
        "amplify:CreateDeployment",
        "amplify:StartDeployment",
        "amplify:StartJob",
        "amplify:StopJob",
        "amplify:TagResource",
        "amplify:UntagResource"
      ],
      "Resource": "arn:aws:amplify:*:*:apps/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "S3BucketPolicyOnCdkStagingBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::cdk-hnb659fds-assets-${aws:PrincipalAccount}-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "KMSForWorkshopEncryptedResources",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:*:*:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "lambda.us-east-1.amazonaws.com",
            "lambda.us-west-2.amazonaws.com",
            "lambda.eu-west-1.amazonaws.com",
            "secretsmanager.us-east-1.amazonaws.com",
            "secretsmanager.us-west-2.amazonaws.com",
            "secretsmanager.eu-west-1.amazonaws.com"
          ]
        },
        "ForAnyValue:StringLike": {
          "kms:ResourceAliases": [
            "alias/aws/lambda",
            "alias/aws/secretsmanager",
            "alias/workshop-*"
          ]
        }
      }
    },
    {
      "Sid": "CWReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetDashboard",
        "cloudwatch:ListDashboards"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CWWorkshopAlarmsAndDashboards",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:PutDashboard",
        "cloudwatch:DeleteDashboards",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": [
        "arn:aws:cloudwatch:*:*:alarm:workshop-*",
        "arn:aws:cloudwatch::*:dashboard/workshop-*",
        "arn:aws:cloudwatch::*:dashboard/agentic-*"
      ]
    },
    {
      "Sid": "CWNoResourceLevel",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:*:*:function:workshop-*",
        "arn:aws:lambda:*:*:function:ac-*",
        "arn:aws:lambda:*:*:function:agentcore-*"
      ]
    },
    {
      "Sid": "LambdaUpdateConfigurationPlatformFunctionsOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:*:*:function:agentcore-gateway-sync",
        "arn:aws:lambda:*:*:function:agentcore-gateway-response-interceptor",
        "arn:aws:lambda:*:*:function:ac-gateway-request-interceptor",
        "arn:aws:lambda:*:*:function:ac-gateway-response-interceptor",
        "arn:aws:lambda:*:*:function:ac-auto-review"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-west-2",
            "us-east-1",
            "eu-west-1"
          ]
        },
        "Null": {
          "lambda:Layer": "true"
        }
      }
    },
    {
      "Sid": "LambdaList",
      "Effect": "Allow",
      "Action": [
        "lambda:ListFunctions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsReadOnly",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartLiveTail",
        "logs:ListTagsForResource",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "logs:StopQuery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManagerListOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*"
    }
  ]
}
