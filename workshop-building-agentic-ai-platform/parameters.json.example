{
  "_comment": "Optional overrides for static/cfn/registry/workshop-registry-stack.yaml. Every parameter below has a working default in the template, so this file is only needed if you want to diverge from it. Leave DocumentDBPassword empty to have the data stack auto-generate one in Secrets Manager (recommended) — never commit a real password. Note there is no ingress-CIDR parameter: MainAlbSG derives its port-80 source from the AWS-managed CloudFront origin-facing prefix list at deploy time.",
  "Parameters": {
    "EnvironmentName": "workshop",
    "VpcCidr": "10.0.0.0/16",
    "DocumentDBUsername": "docdbadmin",
    "DocumentDBPassword": "",
    "DocumentDBInstanceClass": "db.t3.medium",
    "BaseDomain": "",
    "HostedZoneId": "",
    "UseRegionalDomains": "false"
  }
}
