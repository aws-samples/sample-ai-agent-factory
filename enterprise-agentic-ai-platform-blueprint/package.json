{
  "name": "enterprise-agentic-ai-platform-blueprint",
  "version": "1.0.0",
  "description": "Multi-account CDK blueprint for enterprise agentic AI on Amazon Bedrock AgentCore.",
  "private": true,
  "license": "MIT-0",
  "bin": {
    "agentic-ai-platform": "bin/agentic-ai-platform.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "test": "jest",
    "test:conformance": "jest --testPathPattern=tests/conformance",
    "test:unit": "jest --testPathPattern=tests/unit",
    "synth": "cdk synth",
    "cdk": "cdk",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "scrub": "bash scripts/scrub-security-leakage.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "aws-cdk": "^2.150.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "cdk-nag": "^2.28.186",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21",
    "tsconfig-paths": "^4.2.0"
  }
}
