{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "typeRoots": ["./node_modules/@types"],
    "outDir": "dist",
    "rootDir": ".",
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@agenticai/platform-baselines": ["packages/platform-baselines/src/index.ts"],
      "@agenticai/platform-baselines/*": ["packages/platform-baselines/src/*"],
      "@agenticai/platform-tool-catalogue": ["packages/platform-tool-catalogue/src/index.ts"],
      "@agenticai/platform-tool-catalogue/*": ["packages/platform-tool-catalogue/src/*"],
      "@agenticai/tool-cedar-wrapper": ["packages/tool-cedar-wrapper/src/index.ts"],
      "@agenticai/tool-cedar-wrapper/*": ["packages/tool-cedar-wrapper/src/*"],
      "@agenticai/organizations": ["packages/organizations/src/index.ts"],
      "@agenticai/organizations/*": ["packages/organizations/src/*"],
      "@agenticai/landing-zone": ["packages/landing-zone/src/index.ts"],
      "@agenticai/landing-zone/*": ["packages/landing-zone/src/*"],
      "@agenticai/bedrock-guardrails": ["packages/bedrock-guardrails/src/index.ts"],
      "@agenticai/bedrock-guardrails/*": ["packages/bedrock-guardrails/src/*"],
      "@agenticai/agentic-vpc": ["packages/agentic-vpc/src/index.ts"],
      "@agenticai/agentic-vpc/*": ["packages/agentic-vpc/src/*"],
      "@agenticai/bedrock-invocation-logging": ["packages/bedrock-invocation-logging/src/index.ts"],
      "@agenticai/bedrock-invocation-logging/*": ["packages/bedrock-invocation-logging/src/*"],
      "@agenticai/litellm-gateway": ["packages/litellm-gateway/src/index.ts"],
      "@agenticai/litellm-gateway/*": ["packages/litellm-gateway/src/*"],
      "@agenticai/platform-inference-gateway": ["packages/platform-inference-gateway/src/index.ts"],
      "@agenticai/platform-inference-gateway/*": ["packages/platform-inference-gateway/src/*"],
      "@agenticai/agentcore-gateway": ["packages/agentcore-gateway/src/index.ts"],
      "@agenticai/agentcore-gateway/*": ["packages/agentcore-gateway/src/*"],
      "@agenticai/agentcore-identity": ["packages/agentcore-identity/src/index.ts"],
      "@agenticai/agentcore-identity/*": ["packages/agentcore-identity/src/*"],
      "@agenticai/agentcore-memory": ["packages/agentcore-memory/src/index.ts"],
      "@agenticai/agentcore-memory/*": ["packages/agentcore-memory/src/*"],
      "@agenticai/agentcore-runtime": ["packages/agentcore-runtime/src/index.ts"],
      "@agenticai/agentcore-runtime/*": ["packages/agentcore-runtime/src/*"],
      "@agenticai/agentcore-registry": ["packages/agentcore-registry/src/index.ts"],
      "@agenticai/agentcore-registry/*": ["packages/agentcore-registry/src/*"],
      "@agenticai/agent-registry": ["packages/agent-registry/src/index.ts"],
      "@agenticai/agent-registry/*": ["packages/agent-registry/src/*"],
      "@agenticai/developer-access": ["packages/developer-access/src/index.ts"],
      "@agenticai/developer-access/*": ["packages/developer-access/src/*"],
      "@agenticai/developer-cli": ["packages/developer-cli/src/index.ts"],
      "@agenticai/developer-cli/*": ["packages/developer-cli/src/*"],
      "@agenticai/bedrock-quotas": ["packages/bedrock-quotas/src/index.ts"],
      "@agenticai/bedrock-quotas/*": ["packages/bedrock-quotas/src/*"],
      "@agenticai/rag": ["packages/rag/src/index.ts"],
      "@agenticai/rag/*": ["packages/rag/src/*"],
      "@agenticai/agentic-app": ["packages/agentic-app/src/index.ts"],
      "@agenticai/agentic-app/*": ["packages/agentic-app/src/*"],
      "@agenticai/observability": ["packages/observability/src/index.ts"],
      "@agenticai/observability/*": ["packages/observability/src/*"],
      "@agenticai/cost-allocation": ["packages/cost-allocation/src/index.ts"],
      "@agenticai/cost-allocation/*": ["packages/cost-allocation/src/*"],
      "@agenticai/evaluation-gates": ["packages/evaluation-gates/src/index.ts"],
      "@agenticai/evaluation-gates/*": ["packages/evaluation-gates/src/*"],
      "@agenticai/online-evaluation": ["packages/online-evaluation/src/index.ts"],
      "@agenticai/online-evaluation/*": ["packages/online-evaluation/src/*"],
      "@agenticai/eu-ai-act-compliance": ["packages/eu-ai-act-compliance/src/index.ts"],
      "@agenticai/eu-ai-act-compliance/*": ["packages/eu-ai-act-compliance/src/*"],
      "@agenticai/agent-lifecycle": ["packages/agent-lifecycle/src/index.ts"],
      "@agenticai/agent-lifecycle/*": ["packages/agent-lifecycle/src/*"],
      "@agenticai/agent-protocols": ["packages/agent-protocols/src/index.ts"],
      "@agenticai/agent-protocols/*": ["packages/agent-protocols/src/*"],
      "@agenticai/agent-resilience": ["packages/agent-resilience/src/index.ts"],
      "@agenticai/agent-resilience/*": ["packages/agent-resilience/src/*"],
      "@agenticai/hitl": ["packages/hitl/src/index.ts"],
      "@agenticai/hitl/*": ["packages/hitl/src/*"],
      "@agenticai/federation": ["packages/federation/src/index.ts"],
      "@agenticai/federation/*": ["packages/federation/src/*"],
      "@agenticai/pii-redaction": ["packages/pii-redaction/src/index.ts"],
      "@agenticai/pii-redaction/*": ["packages/pii-redaction/src/*"],
      "@agenticai/tenant-quota-guard": ["packages/tenant-quota-guard/src/index.ts"],
      "@agenticai/tenant-quota-guard/*": ["packages/tenant-quota-guard/src/*"],
      "@agenticai/otel-genai-semconv": ["packages/otel-genai-semconv/src/index.ts"],
      "@agenticai/otel-genai-semconv/*": ["packages/otel-genai-semconv/src/*"],
      "@agenticai/catalogue-drift-detector": ["packages/catalogue-drift-detector/src/index.ts"],
      "@agenticai/catalogue-drift-detector/*": ["packages/catalogue-drift-detector/src/*"]
    }
  },
  "include": [
    "bin/**/*.ts",
    "packages/**/*.ts",
    "apps/**/*.ts",
    "pipelines/**/*.ts",
    "blueprints/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "cdk.out", "dist", "**/*.d.ts"]
}
